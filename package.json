{
  "name": "cv-harness",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node scripts/tests.mjs",
    "test:opportunity-canonical": "node --import tsx --test test/database/canonical/canonical.test.ts",
    "test:opportunity-feedback": "node --import tsx --test test/database/adaptive-search/database.test.ts",
    "test:opportunity-feedback-defaults": "node --import tsx --test test/database/adaptive-search/defaults.test.ts",
    "test:adaptive-feedback-snapshots": "node --import tsx --test test/database/adaptive-search/snapshots.test.ts",
    "test:adaptive-search-plans": "node --import tsx --test test/database/adaptive-search/plans.test.ts",
    "test:adaptive-search-attribution": "node --import tsx --test test/database/adaptive-search/attribution.test.ts",
    "test:adaptive-search-preferences": "node --import tsx --test test/database/adaptive-search/preferences.test.ts",
    "test:adaptive-search-startup": "node --import tsx --test test/database/adaptive-search/startup.test.ts",
    "test:adaptive-search-recovery": "node --import tsx --test test/unit/meta-search/adaptiveSearchTransport.test.ts test/unit/meta-search/adaptiveSearchCheckpoint.test.ts test/unit/meta-search/adaptiveSearchDiagnostics.test.ts test/unit/meta-search/adaptiveSearchTask.test.ts test/unit/meta-search/adaptiveSearchStartup.test.ts test/unit/meta-search/adaptiveSearchProtocol.test.ts",
    "test:adaptive-search-batches": "node --import tsx --test test/database/adaptive-search/batches.test.ts",
    "test:refinement": "node scripts/tests.mjs refinement",
    "refinement:prompts": "node --import tsx test/protocol/refinement/generate.ts",
    "refinement:prompts:check": "node --import tsx test/protocol/refinement/generate.ts --check",
    "test:refinement-protocol": "node scripts/tests.mjs protocol",
    "refinement:live": "node --import tsx test/protocol/refinement/run.ts",
    "test:e2e:serve": "vite --config test/browser/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test:adaptive-search-setup": "node --import tsx --test test/database/adaptive-search/setup.test.ts",
    "test:adaptive-search-dashboard": "node --import tsx --test test/database/adaptive-search/dashboard.test.ts",
    "test:adaptive-search-breadth": "node --import tsx --test test/database/adaptive-search/breadth.test.ts",
    "test:adaptive-feedback-inclusion": "node --import tsx --test test/database/adaptive-search/inclusion.test.ts",
    "adaptive:release:check": "node --import tsx scripts/adaptiveSearchRelease.ts --check",
    "test:adaptive-search-release": "node --import tsx --test test/database/adaptive-search/release.test.ts",
    "test:adaptive-search-dashboard-settings": "node --import tsx --test test/database/adaptive-search/dashboardSettings.test.ts",
    "test:adaptive-search-payload-contract": "node --import tsx --test test/database/adaptive-search/payloadContract.test.ts",
    "test:search-schedule-intervals": "node --import tsx --test test/database/adaptive-search/scheduleIntervals.test.ts",
    "db:schema:write": "node --import tsx scripts/databaseSchema.ts --write",
    "db:schema:check": "node --import tsx scripts/databaseSchema.ts --check",
    "adaptive:release:write": "node --import tsx scripts/adaptiveSearchRelease.ts --write",
    "test:database": "node scripts/tests.mjs database",
    "test:unit": "node scripts/tests.mjs unit",
    "test:integration": "node scripts/tests.mjs integration",
    "test:browser": "node test/browser/run.mjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@primeuix/themes": "^1.2.5",
    "@supabase/supabase-js": "2.116.0",
    "d3-force-3d": "^3.0.6",
    "fontkit": "2.0.4",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "html2canvas": "1.4.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "0.20.2",
    "primevue": "^4.5.5",
    "svg-to-pdfkit": "0.1.8",
    "three": "^0.187.0",
    "vue": "^3.5.24",
    "vuedraggable": "^4.1.0",
    "wawoff2": "2.0.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.1",
    "@types/pdfkit": "^0.17.6",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
