{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive search lifecycle v1 response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_contract_version",
        "compatible",
        "error"
      ],
      "properties": {
        "lifecycle_contract_version": {
          "const": 1
        },
        "compatible": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 80
            },
            "retryable": {
              "const": false
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_contract_version",
        "compatible",
        "operation_id",
        "mode",
        "scope",
        "outcome",
        "target",
        "writes",
        "abort",
        "restart",
        "worker_termination",
        "delivery_status"
      ],
      "properties": {
        "lifecycle_contract_version": {
          "const": 1
        },
        "compatible": {
          "const": true
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "mode": {
          "enum": [
            "abort",
            "abort_and_restart"
          ]
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_id",
            "search_id",
            "project_ref",
            "task_id"
          ],
          "properties": {
            "user_id": {
              "type": "string",
              "format": "uuid"
            },
            "search_id": {
              "type": "string",
              "format": "uuid"
            },
            "project_ref": {
              "type": "string",
              "pattern": "^[a-z0-9]{20}$"
            },
            "task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "outcome": {
          "enum": [
            "prepared",
            "no_active_run",
            "ambiguous_active_run",
            "target_changed",
            "binding_changed",
            "aborted"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id",
                "version",
                "status",
                "lease_expires_at"
              ],
              "properties": {
                "run_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "status": {
                  "enum": [
                    "running",
                    "failed",
                    "complete"
                  ]
                },
                "lease_expires_at": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "format": "date-time"
                    }
                  ]
                }
              }
            }
          ]
        },
        "writes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted_batches",
            "saved_items",
            "verified_items"
          ],
          "properties": {
            "accepted_batches": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32
            },
            "saved_items": {
              "type": "integer",
              "minimum": 0
            },
            "verified_items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "abort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verified",
            "reason",
            "lease_released"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_applied",
                "aborted",
                "not_required",
                "conflict"
              ]
            },
            "verified": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                null,
                "owner_cancelled"
              ]
            },
            "lease_released": {
              "type": "boolean"
            }
          }
        },
        "restart": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "status",
            "dispatch_receipt"
          ],
          "properties": {
            "run_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "not_requested",
                "reserved_not_dispatched",
                "startup_accepted",
                "complete",
                "failed",
                "blocked"
              ]
            },
            "dispatch_receipt": {
              "type": "null"
            }
          }
        },
        "worker_termination": {
          "const": "unknown"
        },
        "delivery_status": {
          "const": "unknown"
        }
      }
    }
  ]
}
